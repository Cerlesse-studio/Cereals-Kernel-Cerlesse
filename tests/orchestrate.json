{
  "concurrency": 2,
  "scenarios": [
    {
      "name": "boot",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/boot/serial.log",
        "--ovmf-vars", "build/orch/boot/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!"
      ],
      "serialLog": "build/orch/boot/serial.log",
      "expect": ["Kernel started!"],
      "timeoutSec": 60
    },
    {
      "name": "memory",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/memory/serial.log",
        "--ovmf-vars", "build/orch/memory/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "heap: Box/Vec/String PASS",
        "--expect", "frame: stress PASS",
        "--expect", "paging: map/unmap PASS",
        "--expect", "context: switch PASS"
      ],
      "serialLog": "build/orch/memory/serial.log",
      "expect": [
        "Kernel started!",
        "heap: Box/Vec/String PASS",
        "frame: stress PASS",
        "paging: map/unmap PASS",
        "context: switch PASS"
      ],
      "timeoutSec": 60
    },
    {
      "name": "exception",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--disk", "build/disk-exception.img",
        "--serial-log", "build/orch/exception/serial.log",
        "--ovmf-vars", "build/orch/exception/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "EXCEPTION: divide error"
      ],
      "serialLog": "build/orch/exception/serial.log",
      "expect": ["Kernel started!", "EXCEPTION: divide error"],
      "allowPanic": true,
      "timeoutSec": 60
    },
    {
      "name": "pagefault",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--disk", "build/disk-pagefault.img",
        "--serial-log", "build/orch/pagefault/serial.log",
        "--ovmf-vars", "build/orch/pagefault/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "EXCEPTION: page fault",
        "--expect", "CR2=0x500000000000"
      ],
      "serialLog": "build/orch/pagefault/serial.log",
      "expect": ["Kernel started!", "EXCEPTION: page fault", "CR2=0x500000000000"],
      "allowPanic": true,
      "timeoutSec": 60
    },
    {
      "name": "user",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/user/serial.log",
        "--ovmf-vars", "build/orch/user/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "syscall: syscall/sysret entry armed",
        "--expect", "user: program=/init source=elf",
        "--expect", "segments=4 image_pages=5 writable_pages=2",
        "--expect", "user: enter name=init pid=1 entry=0x8000000000",
        "--expect", "hello from user space",
        "--expect", "user: write fd=1 len=22",
        "--expect", "user: getpid -> 1",
        "--expect", "user: open path=/etc/motd flags=0x0 fd=3",
        "--expect", "user: read fd=3 want=64 got=23",
        "--expect", "motd: hello from ramfs",
        "--expect", "user: write fd=3 len=24",
        "--expect", "hello: static counter=1",
        "--expect", "hello: bad write ret=-14",
        "--expect", "user: exit code=42",
        "--expect", "user: init PASS",
        "--expect", "fs: readback /tmp/hello.txt len=24",
        "--expect", "fs: user data: written by user program",
        "--expect", "user: FAULT vector=0xe error=0x5",
        "--expect", "user: FAULT cr2=0x2000000",
        "--expect", "user: isolation PASS",
        "--expect", "user: probe PASS",
        "--expect", "user: selftest PASS"
      ],
      "serialLog": "build/orch/user/serial.log",
      "expect": [
        "Kernel started!",
        "syscall: syscall/sysret entry armed",
        "user: program=/init source=elf",
        "segments=4 image_pages=5 writable_pages=2",
        "user: enter name=init pid=1 entry=0x8000000000",
        "hello from user space",
        "user: write fd=1 len=22",
        "user: getpid -> 1",
        "user: open path=/etc/motd flags=0x0 fd=3",
        "user: read fd=3 want=64 got=23",
        "motd: hello from ramfs",
        "user: write fd=3 len=24",
        "hello: static counter=1",
        "hello: bad write ret=-14",
        "user: exit code=42",
        "user: init PASS",
        "fs: readback /tmp/hello.txt len=24",
        "fs: user data: written by user program",
        "user: FAULT vector=0xe error=0x5",
        "user: FAULT cr2=0x2000000",
        "user: isolation PASS",
        "user: probe PASS",
        "user: selftest PASS"
      ],
      "timeoutSec": 60
    },
    {
      "name": "fs",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/fs/serial.log",
        "--ovmf-vars", "build/orch/fs/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "fs: mount point=/ fs=ramfs",
        "--expect", "fs: create /init",
        "--expect", "fs: write /etc/motd bytes=23",
        "--expect", "fs: stat /etc/motd kind=file size=23 perms=-rw-r--r--",
        "--expect", "fs: read /etc/motd len=23 data=motd: hello from ramfs",
        "--expect", "fs: mount point=/mnt fs=ramfs-scratch",
        "--expect", "fs: route /mnt/note.txt fs=ramfs-scratch",
        "--expect", "fs: readback /mnt/note.txt len=7 data=v0.7-ok",
        "--expect", "fs: ls / entries=3",
        "--expect", "fs: negative cases PASS",
        "--expect", "fs: selftest PASS"
      ],
      "serialLog": "build/orch/fs/serial.log",
      "expect": [
        "Kernel started!",
        "fs: mount point=/ fs=ramfs",
        "fs: create /init",
        "fs: write /etc/motd bytes=23",
        "fs: stat /etc/motd kind=file size=23 perms=-rw-r--r--",
        "fs: read /etc/motd len=23 data=motd: hello from ramfs",
        "fs: mount point=/mnt fs=ramfs-scratch",
        "fs: route /mnt/note.txt fs=ramfs-scratch",
        "fs: readback /mnt/note.txt len=7 data=v0.7-ok",
        "fs: ls / entries=3",
        "fs: negative cases PASS",
        "fs: selftest PASS"
      ],
      "timeoutSec": 60
    },
    {
      "name": "driver",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/driver/serial.log",
        "--ovmf-vars", "build/orch/driver/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "pci: enumerated devices=",
        "--expect", "vendor=0x1af4 device_id=0x1001",
        "--expect", "pci: 00:03.0 bar0=io:",
        "--expect", "driver: registered index=0 name=virtio-blk-pci",
        "--expect", "virtio-blk: capacity=131072 sectors (64 MiB)",
        "--expect", "driver: probe PASS (devices=",
        "--expect", "matched=1 attached=1 failed=0)",
        "--expect", "block: boot sector sig=0x55aa fstype=FAT16",
        "--expect", "block: write/readback PASS (lba=131071 pattern=0xa5)",
        "--expect", "block: selftest PASS"
      ],
      "serialLog": "build/orch/driver/serial.log",
      "expect": [
        "Kernel started!",
        "pci: enumerated devices=",
        "vendor=0x1af4 device_id=0x1001",
        "pci: 00:03.0 bar0=io:",
        "driver: registered index=0 name=virtio-blk-pci",
        "virtio-blk: capacity=131072 sectors (64 MiB)",
        "driver: probe PASS (devices=",
        "matched=1 attached=1 failed=0)",
        "block: boot sector sig=0x55aa fstype=FAT16",
        "block: write/readback PASS (lba=131071 pattern=0xa5)",
        "block: selftest PASS"
      ],
      "timeoutSec": 60
    },
    {
      "name": "keyboard",
      "cmd": [
        "python3", "tests/test_keyboard.py",
        "--disk", "build/disk.img",
        "--serial-log", "build/orch/keyboard/serial.log",
        "--ovmf-vars", "build/orch/keyboard/OVMF_VARS.fd",
        "--monitor", "build/orch/keyboard/monitor.sock",
        "--timeout", "30",
        "--key", "a",
        "--key", "b",
        "--expect", "KBIRQ enabled",
        "--expect", "KBIRQ ENTRY",
        "--expect", "KB a",
        "--expect", "KBIRQ EXIT",
        "--expect", "IRQ0_heartbeat tick="
      ],
      "serialLog": "build/orch/keyboard/serial.log",
      "expect": [
        "KBIRQ enabled",
        "KBIRQ ENTRY",
        "KB a",
        "KBIRQ EXIT",
        "IRQ0_heartbeat tick="
      ],
      "timeoutSec": 75
    },
    {
      "name": "scheduler",
      "cmd": [
        "python3", "tests/test_boot.py",
        "--serial-log", "build/orch/scheduler/serial.log",
        "--ovmf-vars", "build/orch/scheduler/OVMF_VARS.fd",
        "--timeout", "30",
        "--expect", "Kernel started!",
        "--expect", "sched: spawn pid=1 name=task_a",
        "--expect", "task_a: entered",
        "--expect", "task_b: entered",
        "--expect", "task_c: entered",
        "--expect", "sched: switch pid=3 -> 0",
        "--expect", "sched: round-robin wrap PASS",
        "--expect", "pipe: create id=1 cap=64",
        "--expect", "pipe: write id=1 len=10",
        "--expect", "pipe: read id=1 len=10",
        "--expect", "pipe: selftest PASS"
      ],
      "serialLog": "build/orch/scheduler/serial.log",
      "expect": [
        "Kernel started!",
        "sched: spawn pid=1 name=task_a",
        "task_a: entered",
        "task_b: entered",
        "task_c: entered",
        "sched: switch pid=3 -> 0",
        "sched: round-robin wrap PASS",
        "pipe: create id=1 cap=64",
        "pipe: write id=1 len=10",
        "pipe: read id=1 len=10",
        "pipe: selftest PASS"
      ],
      "timeoutSec": 60
    }
  ]
}
